{
	"name": "{APP_NAME}",
	"private": true,
	"version": "0.0.0",
	"description": "{DESC}",
	"main": "src/index.ts",
	"eslintConfig": {
		"rules": {
			"quotes": [
				"error",
				"single",
				{
					"avoidEscape": true
				}
			],
			"semi": [
